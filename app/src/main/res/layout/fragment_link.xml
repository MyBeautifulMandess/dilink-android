<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pairTitle"
                    style="@style/Text_DiLink_Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status_paired_none" />

                <TextView
                    android:id="@+id/pairHint"
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/pair_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scan"
                    style="@style/Widget_DiLink_Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/action_camera" />

                <TextView
                    style="@style/Text_DiLink_Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/camera_hint" />

                <TextView
                    style="@style/Text_DiLink_Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/section_manual" />

                <TextView
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/manual_hint" />

                <EditText
                    android:id="@+id/manualLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/manual_link_hint"
                    android:inputType="textUri|textNoSuggestions"
                    android:maxLines="3"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp"
                    android:autofillHints="" />

                <EditText
                    android:id="@+id/manualToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/manual_token_hint"
                    android:inputType="textVisiblePassword|textNoSuggestions"
                    android:maxLines="2"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp"
                    android:autofillHints="" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/paste"
                    style="@style/Widget_DiLink_Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surface_high"
                    android:text="@string/action_paste"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/manualConnect"
                    style="@style/Widget_DiLink_Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_manual_connect" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/connect"
                        style="@style/Widget_DiLink_Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_connect" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/forget"
                        style="@style/Widget_DiLink_Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/surface_high"
                        android:text="@string/action_forget"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text_DiLink_Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_clipboard" />

                <TextView
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/clipboard_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sendClipboard"
                    style="@style/Widget_DiLink_Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/surface_high"
                    android:text="@string/action_send_clipboard"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text_DiLink_Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_files" />

                <TextView
                    android:id="@+id/transferEmpty"
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/transfer_none" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/transfers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pickFile"
                    style="@style/Widget_DiLink_Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/surface_high"
                    android:text="@string/action_send_file"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/error"
            style="@style/Text_DiLink_Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/danger"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
