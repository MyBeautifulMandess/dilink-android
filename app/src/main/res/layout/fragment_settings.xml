<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text_DiLink_Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_sync" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchClipboard"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_clipboard" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchNotifications"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_notifications" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMedia"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_media" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFiles"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_files" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPlanner"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_planner" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchWifi"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_wifi_only" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAuto"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_auto" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchIdle"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/row_idle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp">

                    <TextView
                        style="@style/Text_DiLink_Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/row_idle_minutes" />

                    <EditText
                        android:id="@+id/idleMinutes"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:inputType="number"
                        android:maxLength="3"
                        android:autofillHints=""
                        android:importantForAutofill="no"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/idle_hint" />

                <TextView
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/wifi_only_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Text_DiLink_Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_access" />

                <TextView
                    android:id="@+id/accessNotifications"
                    style="@style/Widget_DiLink_SwitchRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/grantNotifications"
                    style="@style/Widget_DiLink_Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/surface_high"
                    android:text="@string/action_grant"
                    android:textColor="@color/text_primary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/ignoreInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_ignore"
                        android:inputType="text"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp"
                        android:autofillHints="" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addIgnore"
                        style="@style/Widget_DiLink_Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_add" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ignoreList"
                    style="@style/Text_DiLink_Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/version"
            style="@style/Text_DiLink_Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
